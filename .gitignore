# ==================== 依赖 ====================
# node_modules 不提交；但 package-lock.json 需要提交，以保证云端构建依赖一致
node_modules/
.pnp
.pnp.js

# ==================== VitePress / Vite 构建产物与缓存 ====================
docs/.vitepress/dist/
docs/.vitepress/cache/
node_modules/.vite/
dist/
out/
*.tsbuildinfo
# 本地全文搜索索引（使用博客主题时生成，可随时重建）
pagefind/

# ==================== 日志 ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== 环境变量 / 密钥（切勿提交）====================
.env
.env.*
!.env.example
*.local

# ==================== 编辑器 / IDE ====================
# VS Code：忽略个人设置，保留可共享的推荐扩展清单
.vscode/*
!.vscode/extensions.json
# JetBrains 系列（WebStorm/IDEA 等）
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ==================== 操作系统杂项 ====================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
# Linux
*~

# ==================== 临时 / 备份文件 ====================
*.tmp
*.temp
*.bak
*.swp
